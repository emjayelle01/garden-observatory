# Shell scripts must keep LF line endings so they run on the Raspberry Pi.
# (CRLF would cause "$'\r': command not found" errors under bash.)
*.sh text eol=lf

# systemd units and the templates they are rendered from must also keep LF.
# A trailing CR would become part of a directive's value (e.g. "User=mgo\r")
# and the unit would fail to start.
*.service text eol=lf
*.service.template text eol=lf

# Timers are systemd units too: a CR would land inside OnCalendar= and the
# schedule would be rejected.
*.timer text eol=lf

# logrotate configuration is installed verbatim into /etc/logrotate.d. A CR
# would become part of a directive and break rotation for the whole host.
*.logrotate text eol=lf

# The deployment gateway is an extensionless executable installed to
# /usr/local/sbin, so it is not covered by *.sh. A CR after its shebang would
# make the kernel look for an interpreter named "bash\r" and every sudo call
# would fail with "no such file or directory".
scripts/deploy/mgo-validate text eol=lf

# sudoers policies are parsed by visudo. A CR would become part of the command
# path in the rule, so the gateway would never match and deployment would be
# refused for the one account that is supposed to have it.
*.sudoers text eol=lf
